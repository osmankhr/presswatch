# AgentMail (digest + alert emails)
AGENTMAIL_API_KEY=your_agentmail_api_key_here

# Comma-separated digest recipient list
DIGEST_RECIPIENTS=o.kahraman.phys@gmail.com

# Who gets the "fell back to OpenRouter" alert email (defaults to
# o.kahraman.phys@gmail.com if unset, regardless of DIGEST_RECIPIENTS)
PRESSWATCH_ALERT_RECIPIENT=o.kahraman.phys@gmail.com

# Exa search (Stage 1) -- same key already used by hr_tech's candidate_pool
EXA_API_KEY=your_exa_api_key_here

# LLM provider: Claude by default via an isolated n8n profile
# (~/n8n-data/claude-profiles/<profile>/), OpenRouter as a failure fallback.
PRESSWATCH_CLAUDE_PROFILE=aiworkspacetr
PRESSWATCH_CLAUDE_MODEL=claude-sonnet-5
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet
